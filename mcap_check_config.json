{
  "_comment": "远程分析内部默认参数；日常帧率和同步阈值优先由 boxes.yaml 覆盖。",
  "stable_seconds": 180,
  "rate_tolerance_percent": 5.0,
  "gap_factor": 2.5,
  "sync_threshold_ms": 1000.0,
  "coverage_threshold_ms": 100.0,
  "streams": {
    "camera": {"_comment": "RGB 使用 timing.event_time_ns，单位纳秒。", "topic": "/head/rgb/compressed", "expected_hz": 30.0, "timestamp_path": "timing.event_time_ns", "timestamp_unit": "ns"},
    "head_imu": {"_comment": "头 IMU 的设备时间单位是微秒，分析时会换算为纳秒。", "topic": "/head/imu", "expected_hz": 100.0, "timestamp_path": "device_timestamp_us", "timestamp_unit": "us"},
    "left_imu": {"_comment": "左 IMU 使用 capture_time_ns。", "topic": "/forearm/left/imu", "expected_hz": 100.0, "timestamp_path": "capture_time_ns", "timestamp_unit": "ns"},
    "right_imu": {"_comment": "右 IMU 使用 capture_time_ns。", "topic": "/forearm/right/imu", "expected_hz": 100.0, "timestamp_path": "capture_time_ns", "timestamp_unit": "ns"},
    "left_emg": {"_comment": "左 EMG 使用首个 sample 的 capture_time_ns。", "topic": "/forearm/left/emg_batch", "expected_hz": 2000.0, "timestamp_path": "samples.0.capture_time_ns", "timestamp_unit": "ns"},
    "right_emg": {"_comment": "右 EMG 使用首个 sample 的 capture_time_ns。", "topic": "/forearm/right/emg_batch", "expected_hz": 2000.0, "timestamp_path": "samples.0.capture_time_ns", "timestamp_unit": "ns"}
  }
}
